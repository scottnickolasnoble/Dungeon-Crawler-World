.godot/

# Temporary prototype characters, about 1 GB, until the redesign replaces them.
# tools/export_prototype.mjs regenerates them. Only the ones Floor 0 places are kept in the repository.
models/monsters/*
!models/monsters/dummy.glb
!models/monsters/dummy.glb.import
!models/monsters/goblin_v1.glb
!models/monsters/goblin_v1.glb.import
