!models/monsters/goblin_v4.glb.import
!models/monsters/goblin_v6.glb
!models/monsters/goblin_v6.glb.import
models/npcs/*
!models/npcs/pool/
models/npcs/pool/*
!models/npcs/pool/human_quest.glb
!models/npcs/pool/human_quest.glb.import
!models/npcs/pool/human_guard.glb
!models/npcs/pool/human_guard.glb.import
!models/npcs/pool/gutterkin_gossip.glb
!models/npcs/pool/gutterkin_gossip.glb.import
